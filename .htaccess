# ============ greeksiptv.gr (Apache / LiteSpeed on Hostinger) ============
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType "text/plain; charset=UTF-8" .txt

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the non-www domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://greeksiptv.gr%{REQUEST_URI} [L,R=301]

# Clean URLs: /about -> /about.html ; /about.html stays working
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)/?$ /$1.html [L]

# ---- Old WordPress pages -> new pages ----
RewriteRule ^reseller\-progam/?$ /reseller.html [R=301,L]
RewriteRule ^terms\-and\-conditions/?$ /terms.html [R=301,L]
RewriteRule ^refund\-and\-cancellation\-policy/?$ /refund-policy.html [R=301,L]
RewriteRule ^privacy\-policy/?$ /privacy.html [R=301,L]
RewriteRule ^installation\-guide/?$ /setup-guide.html [R=301,L]
RewriteRule ^contact\-us/?$ /contact.html [R=301,L]
RewriteRule ^about\-us/?$ /about.html [R=301,L]

# ---- Old WooCommerce products -> pricing ----
RewriteRule ^product/ /#pricing [R=301,NE,L]
RewriteRule ^(shop|cart|checkout|my-account)(/.*)?$ /#pricing [R=301,NE,L]

# ---- Old sitemaps, categories, feeds ----
RewriteRule ^(sitemap_index|wp-sitemap|page-sitemap|post-sitemap|product-sitemap|category-sitemap)\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^category/ /blog/ [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ /blog/ [R=301,L]

</IfModule>

# ---------- Performance ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
